<!-- Content for index page -->
<!DOCTYPE html>
<html lang = "en">

   <head>
       <meta charset="UTF-8">
       <title>Admin Dashboard</title>
       <link rel="stylesheet" href="/style.css">
   </head>

   <body>
    <%- include('nav')%> <!-- Allows to toggle between admin/main page -->
    <h1> Add Product </h1>
    <form action="/admin" method="POST">
        <input name="title" placeholder="Title" required>
        <input name="description" placeholder="Description">
        <input name="quantity" type="number" min="0" placeholder="Quantity" required>
        <input name="price" type="number" step="0.01" min="0" placeholder="Price" required>
        <button type="submit">Add</button>
      </form>

       <h1> Current Products </h1>
       <!-- Get All Products to Display -->
       <% if (products.length > 0) { %>
           <table>
               <thead><tr><th>Title</th><th>Price</th><th>Quantity</th><th>Description</th><th></th></tr></thead>
           <tbody>
                   <% products.forEach(item => { %>
                       <tr>
                       <td><%= item.title %></td>
                       <td><%= item.price %></td>
                       <td><%= item.quantity %></td>
                       <td><%= item.description %></td>
                       <td><a href="/admin/delete/<%= item.product_id%>"><button id="delete">Delete</button></a></button></td>
                   </tr>
                   <% }) %>
                   </tbody>
       </table>
       <% } else { %>
           <p> No Products Found. </p>
       <% } %>
   </body>

</html>