<!-- Content for index page -->
 <!DOCTYPE html>
 <html lang = "en">

    <head>
        <meta charset="UTF-8">
        <title>Products</title>
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <h1> Products </h1>
        <!-- Get All Products to Display -->
        <% if (products.length > 0) { %>
            <table>
                <thead><tr><th>Title</th><th>Price</th><th>Quantity</th><th>Description</th><th></th></tr></thead>
            <tbody>
                    <% products.forEach(item => { %>
                        <tr>
                        <td><%= item.title %></td>
                        <td><%= item.price %></td>
                        <td><%= item.quantity %></td>
                        <td><%= item.description %></td>
                        <td><a href="/review/<%=item.product_id%>"><button id="select">Select</button></a></button></td>
                    </tr>
                    <% }) %>
                    </tbody>
        </table>
        <% } else { %>
            <p> No Products Found. </p>
        <% } %>
    </body>

 </html>