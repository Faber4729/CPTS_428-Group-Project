<!DOCTYPE html>
<html lang = "en">

   <head>
       <meta charset="UTF-8">
       <title>Products</title>
       <link rel="stylesheet" href="/style.css">
   </head>
   
   <h1>Product</h1>
    <table>
        <thead><tr><th>Title</th><th>Description</th></tr></thead>
    <tbody>
                <tr>
                <td><%= product.title %></td>
                <td><%= product.description %></td>
            </tr>
            </tbody>
</table>

   <h1>Reviews</h1>
   <% if (reviews.length > 0) { %>
       <table>
           <table>
               <thead><tr><th>Review Number</th><th>Reviewer</th><th>Product Review</th></tr></thead>
           <tbody>
                   <% reviews.forEach(item => { %>
                       <tr>
                       <td><%= item.review_id%></td>
                       <td><%= item.review_name%></td>
                       <td><%= item.review_body%></td>
                   </tr>
                   <% }) %>
           </tbody>
       </table>>
   <% } else { %>
       <p> No Reviews Found. </p>
   <% } %>

   <h1> Add Review </h1>
    <form action="/review/create/<%= product.product_id%>" method="POST">
        <input name="reviewName" placeholder="Reviewer Name" required>
        <input name="reviewBody" placeholder="Review Text">
        <button type="submit">Add</button>
      </form>

   <a href="/"><button id="select">Home</button></a></button>
</html>