<!DOCTYPE html>
<html lang = "en">

   <head>
       <meta charset="UTF-8">
       <title>Products</title>
       <link rel="stylesheet" href="/views/style.css">
   </head>
   
   <a href="/"><button id="home">&lt;</button></a></button>

   <h1>Product</h1>

   <div class="revbg">
        <table class="revTable">
            <tbody>
                <tr><th>Title</th></tr>
                    <tr><td><%= product.title %></td> </tr>
                <tr><th>Description</th></tr>
                    <tr><td><%= product.description %></td></tr>
            </tbody>
        </table>
    </div>

   <h1>Reviews</h1>
    <% if (reviews.length > 0) { %>
        <div class="reviews">
                <% reviews.forEach(item => { %>
                <div class="revbg">
                    <p class="bold"><%= item.review_name%></p>
                    <p><%= item.review_body%></p>
                </div>
            <% }) %>
        </div>
    <% } else { %>
       <p> No Reviews Found. </p>
   <% } %>

   <h1> Add Review </h1>
    <form action="/review/create/<%= product.product_id%>" method="POST">
        <div id="reviewGrid">
            <input name="reviewName" placeholder="Reviewer Name" class="infoBar" required>
            <input name="reviewBody" placeholder="Review Text" class="infoBar">
            <button type="submit" class="add">Add Review</button>
        </div>
    </form>
</html>